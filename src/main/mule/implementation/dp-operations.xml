				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var dp = vars.requestParams.payload
---
[
	{
		"City__c": dp.city default "",
		"Contact__c": dp.contact default "",
		"IsActive__c": dp.isActive default true,
		"Name__c": dp.name default "",
		"Partner_Id__c": dp.partnerId default "",
		"Email__c": dp.email default ""
	}
]]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
