	<sub-flow name="put-deliverypartner-sub-flow" doc:id="53ca06df-c996-4f10-bd2b-b7e590df68e1" >
		<json-logger:logger doc:name="log-put-deliverypartner-sub-flow-start" doc:id="126e494d-3256-49bc-8c69-4034f5de2a42" config-ref="json-logger-config" message='#["-----------" ++ upper("log-put-deliverypartner-sub-flow-start") ++ "-------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="get-deliverypartner-byid-sub-flow" doc:id="77503bf7-b7de-4604-ae46-15ffec47df3f" name="get-deliverypartner-byid-sub-flow" target="partner"/>
		<ee:transform doc:name="Transform Message" doc:id="79ad26ef-aebd-4e00-8f4f-445e5d46d368" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var updDet = vars.requestParams.payload
var sf = {
	"Availability_Status__c": updDet.availabilityStatus default "",
	"City__c": updDet.city default "",
	"Contact__c": updDet.contact default "",
	"IsActive__c": updDet.isActive default "",
	"Last_Assigned_Time__c": updDet.lastAssignedTime default "",
	"Name__c": updDet.name default "",
	"Partner_Id__c": updDet.partnerId default ""
} filterObject ((value, key, index) -> value != "")
---
[(vars.partner[0] -- (sf pluck ((value, key, index) ->key)) ++ sf)]

]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "PUT",
	"path": "/deliveryPartners/" ++ vars.requestParams.uriParams.partnerId as String default ""
}]]></ee:set-variable>
			
</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sys-api-call-impl-sub-flow" doc:id="ea1c4478-1313-4cfa-9b60-6177c9377a14" name="sys-api-call-impl-sub-flow" />
