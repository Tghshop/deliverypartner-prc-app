---
{
	email: vars.requestParams.payload.email,
	subject: "Welcome to TGHShop – Your Account Has Been Successfully Created",
	body: "Hello " ++ vars.requestParams.payload.name as String ++ "\n" ++ 
	"Thank you for signing in to TGHShop.\n" ++ 
	"Your delivery partner profile has been successfully created in our system."
}]]></ee:set-payload>
