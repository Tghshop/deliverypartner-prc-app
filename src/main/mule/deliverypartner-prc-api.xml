        <ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Delivery Partner record updated successfully",
  partnerId: vars.requestParams.uriParams.partnerId,
  updatedFields: vars.requestParams.payload,
  lastUpdated: now()
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <json-logger:logger doc:name="log-put-deliverypartner-details-end" doc:id="c3b3b57c-8963-4bc8-ace1-b9faae3fb723" config-ref="json-logger-config" message="#[&quot;-------------&quot; ++ upper(&quot;log-put-deliverypartner-details-end&quot;) ++ &quot;-----------&quot;]">
