    <flow name="put:\api\v1\deliveryPartners\(partnerId):application\json:deliverypartner-prc-api-config" doc:id="32bd6606-80fb-49e3-a0f6-236a7e3d1af0">
        <json-logger:logger doc:name="log-put-deliverypartner-details-start" doc:id="ae74ccc8-f66b-480b-bb83-84d8b4e5b250" config-ref="json-logger-config" message="#[&quot;-------------&quot; ++ upper(&quot;log-put-deliverypartner-details-start&quot;) ++ &quot;-----------&quot;]">
